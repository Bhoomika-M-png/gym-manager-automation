# ========================================================
# Gym Manager Automation Configuration
# ========================================================

# Server Port & Timezone
PORT=3000
TZ=Asia/Kolkata

# Automated Schedulers (Cron syntax)
REMINDER_CRON=0 9 * * *
REPORT_CRON=0 8 * * *

# Gym Owner Notification Recipients
OWNER_EMAIL=owner@gym.com
OWNER_WHATSAPP_PHONE=919876543210

# WhatsApp Business Cloud API (Optional - simulated / direct wa.me fallback available)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=gym_membership_expiry_reminder
WHATSAPP_REPORT_TEMPLATE_NAME=gym_daily_report

# Razorpay Online Payment & Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email SMTP Delivery (Gmail / Brevo / SendGrid / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
